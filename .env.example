# Токен от @BotFather.
# Имя намеренно TELEGRAM_BOT_TOKEN, а не BOT_TOKEN: стоковое правило gitleaks
# срабатывает на слово «telegram» рядом с секретом (см. .gitleaks.toml).
TELEGRAM_BOT_TOKEN=

# Telegram user id админов через запятую. Админы допущены без строки в базе и
# раздают доступ остальным: /invite (одноразовая ссылка) и /allow <id>.
# Пустой список = бот никого не пускает. Узнать свой id можно у @userinfobot.
ADMIN_IDS=

# Прокси до api.telegram.org — там, где провайдер блокирует Telegram.
# Сервер: http://127.0.0.1:1080 (sing-box на хосте). Ноутбук: http://127.0.0.1:1082 (mihomo).
# Пусто — прямое соединение.
TELEGRAM_PROXY=http://127.0.0.1:1080

# База доступа: гости, инвайты, последние настройки колоды («Как в прошлый раз»).
# У sqlite абсолютный путь — четыре слэша. На сервере: /var/db/ankideckgen/access.sqlite.
DATABASE_URL=sqlite+aiosqlite:///anki-deck-gen.sqlite

# Рабочий каталог: scratch на каждое Задание (удаляется по завершении) и кэш
# озвучки в подкаталоге media/ — если MEDIA_CACHE_DIR не задан отдельно.
# На сервере каталог релиза read-only, поэтому /var/tmp/anki-deck-gen.
WORK_DIR=/var/tmp/anki-deck-gen
# MEDIA_CACHE_DIR=

# Публичная Google-таблица-пример: показывается в /help и README. Пусто — строки нет.
# EXAMPLE_SHEET_URL=

# Пределы. Заданий в системе разом (в очереди плюс одно в работе); секунд на одно
# Задание; потолок размера присланного файла; потолок записей в колоде (столько же
# запросов к Google TTS); сколько бот помнит разобранную таблицу, пока человек
# выбирает настройки (каждый шаг диалога продлевает).
QUEUE_LIMIT=5
JOB_TIMEOUT_S=900
MAX_FILE_MB=5
MAX_NOTES=1000
PENDING_TTL_S=1800
